CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_LWIP_L2_TO_L3_COPY=y
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# RainMaker requires ESP-IDF 5.1 or later. The 6.12.0 PlatformIO platform
# supplies ESP-IDF 5.5 and retains the original ESP32/ESP-IDF target.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xc000

# ESP RainMaker Wi-Fi provisioning and the lamp's BLE GATT client.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=3120

# Assisted claiming in public RainMaker requires BLE provisioning. Retain the
# BLE controller memory so the sunset lamp client can start after setup.
CONFIG_APP_NETWORK_PROV_TRANSPORT_BLE=y
CONFIG_NETWORK_PROV_KEEP_BLE_ON_AFTER_PROV=y

# Keep AP + STA internet forwarding enabled for the LIFX bulb.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_LWIP_L2_TO_L3_COPY=y
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

# RainMaker TLS memory optimizations and claiming prerequisites.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_ESP_RMAKER_USER_ID_CHECK=y
