# PlatformIO builds ESP-IDF component objects through SCons instead of asking
# Ninja to run component add_custom_command() rules. ESP RainMaker embeds its
# trust certificates with target_add_binary_data(), so materialize those
# assembly sources while CMake configures the project.
function(target_add_binary_data target embed_file embed_type)
    cmake_parse_arguments(_ "" "RENAME_TO" "DEPENDS" ${ARGN})
    idf_build_get_property(_build_dir BUILD_DIR)
    idf_build_get_property(_idf_path IDF_PATH)

    get_filename_component(_data_file "${embed_file}" ABSOLUTE
                           BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    get_filename_component(_data_name "${_data_file}" NAME)
    get_filename_component(_source_file "${_build_dir}/${_data_name}.S" ABSOLUTE
                           BASE_DIR "${CMAKE_BINARY_DIR}")

    set(_rename_args)
    if(_RENAME_TO)
        list(APPEND _rename_args -D "VARIABLE_BASENAME=${_RENAME_TO}")
    endif()

    if(EXISTS "${_data_file}")
        execute_process(
            COMMAND "${CMAKE_COMMAND}"
                    -D "DATA_FILE=${_data_file}"
                    -D "SOURCE_FILE=${_source_file}"
                    ${_rename_args}
                    -D "FILE_TYPE=${embed_type}"
                    -P "${_idf_path}/tools/cmake/scripts/data_file_embed_asm.cmake"
            RESULT_VARIABLE _embed_result
        )
        if(NOT _embed_result EQUAL 0)
            message(FATAL_ERROR "Could not embed ${_data_file}: ${_embed_result}")
        endif()
    elseif(_data_name STREQUAL "x509_crt_bundle")
        # The PlatformIO builder creates this bundle after CMake's configure
        # pass, so give CMake a placeholder source that it will replace later.
        file(WRITE "${_source_file}" "/* generated by PlatformIO */\n")
    else()
        message(FATAL_ERROR "Embedding source does not exist: ${_data_file}")
    endif()

    # PlatformIO creates x509_crt_bundle.S after ESP-IDF configures components.
    target_sources("${target}" PRIVATE "${_source_file}")
endfunction()
